<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".OpportunityDetailActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#263A63"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#FFFFFF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/tvDetailHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Opportunity Details"
            android:layout_marginStart="15dp"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            app:layout_constraintBaseline_toBaselineOf="@id/btnBack"
            app:layout_constraintStart_toEndOf="@id/btnBack"/>

        <ImageButton
            android:id="@+id/btnEdit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_edit"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#FFFFFF"
            app:layout_constraintBaseline_toBaselineOf="@id/btnBack"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerBar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardMain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <TextView
                    android:id="@+id/tvDetailType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Internship"
                    android:textSize="13sp"
                    android:textColor="@color/white"
                    android:background="#6C5DD3"
                    android:padding="5dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tvDetailTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Google Summer Internship 2026"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp"
                    app:layout_constraintTop_toBottomOf="@id/tvDetailType"/>

                <ImageView
                    android:id="@+id/ivDeadlineIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@android:drawable/ic_menu_my_calendar"
                    app:tint="#6C5DD3"
                    app:layout_constraintTop_toBottomOf="@id/tvDetailTitle"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/tvDetailDeadline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Deadline: 30 Sep 2026, 11:59 PM"
                    android:textSize="14sp"
                    app:layout_constraintTop_toTopOf="@id/ivDeadlineIcon"
                    app:layout_constraintBottom_toBottomOf="@id/ivDeadlineIcon"
                    app:layout_constraintStart_toEndOf="@id/ivDeadlineIcon"
                    android:layout_marginStart="8dp" />

                <!-- Days Remaining Chip -->
                <TextView
                    android:id="@+id/tvDaysRemaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12 days left"
                    android:textSize="12sp"
                    android:textColor="#D32F2F"
                    android:background="#FFEBEE"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    app:layout_constraintTop_toBottomOf="@id/ivDeadlineIcon"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginTop="10dp" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Card: Notes -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardNotes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:padding="18dp"
                app:layout_constraintTop_toBottomOf="@id/cardMain"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="14dp">

                <TextView
                    android:id="@+id/tvNotesLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Notes"
                    android:textSize="13sp"
                    android:textColor="#888888"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tvDetailNotes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Requires 2 DSA rounds + 1 HR round. Apply through official portal only."
                    android:textSize="14sp"
                    android:textColor="#333333"
                    app:layout_constraintTop_toBottomOf="@id/tvNotesLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="6dp" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Card: Reference Source -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardSource"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:padding="18dp"
                app:layout_constraintTop_toBottomOf="@id/cardNotes"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="14dp">

                <TextView
                    android:id="@+id/tvSourceLabelDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Heard About This From"
                    android:textSize="13sp"
                    android:textColor="#888888"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tvDetailSource"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="LinkedIn — Post by Google Careers Page"
                    android:textSize="14sp"
                    android:textColor="#333333"
                    app:layout_constraintTop_toBottomOf="@id/tvSourceLabelDetail"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="6dp" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Card: Reference Link -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardLink"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:padding="18dp"
                app:layout_constraintTop_toBottomOf="@id/cardSource"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="14dp">

                <TextView
                    android:id="@+id/tvLinkLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reference Link"
                    android:textSize="13sp"
                    android:textColor="#888888"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tvDetailLink"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="https://careers.google.com/internship2026"
                    android:textSize="14sp"
                    android:textColor="#6C5DD3"
                    android:autoLink="web"
                    app:layout_constraintTop_toBottomOf="@id/tvLinkLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="6dp" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <Button
                android:id="@+id/btnMarkCompleted"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:text="Mark as Applied / Completed"
                android:backgroundTint="#6C5DD3"
                android:textColor="#FFFFFF"
                app:layout_constraintTop_toBottomOf="@id/cardLink"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="24dp" />

            <Button
                android:id="@+id/btnDeleteOpportunity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Delete Opportunity"
                android:textColor="#D32F2F"
                style="?android:attr/borderlessButtonStyle"
                app:layout_constraintTop_toBottomOf="@id/btnMarkCompleted"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="8dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>